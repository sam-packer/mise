# Copy this file to ml/.env and fill in your own keys. ml/.env is gitignored.
# mise-ml reads ml/.env at startup. A variable already set in the shell wins.

# TMDB: themoviedb.org > Settings > API > request a key (Developer).
# Set one of the two: the "API Read Access Token" (long) or the "API Key" (short).
TMDB_TOKEN=
TMDB_API_KEY=

# Hardcover: sign in at hardcover.app, then copy the token from hardcover.app/account/api.
# Paste it without the "Bearer " prefix. It expires after one year.
HARDCOVER_TOKEN=

# ListenBrainz: sign in at listenbrainz.org, then copy the user token from
# listenbrainz.org/settings. The top recordings of each artist need it.
LISTENBRAINZ_TOKEN=

# Last.fm: create an API account at last.fm/api/account/create and copy the API key.
LASTFM_API_KEY=

# Hugging Face (optional): a read token from huggingface.co/settings/tokens. It gives
# faster, rate-limited-less model downloads. The models are public, so it is not required.
HF_TOKEN=

# Cloudflare R2, for `uv run mise-ml publish`. `all` publishes at the end when these are set.
# The account id is the host of the bucket's S3 endpoint:
# https://<account id>.r2.cloudflarestorage.com (dashboard > R2 > the bucket > Settings).
R2_ACCOUNT_ID=
# Dashboard > R2 > Manage API tokens > Create API token. Choose "Object Read & Write" and
# scope the token to both buckets. Copy the Access Key ID and the Secret Access Key. The
# dashboard shows the secret only once.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# The bucket name. The default is "mise".
R2_BUCKET=mise
# Keep this bucket private. Use the same name for CATALOG in wrangler.jsonc.
R2_CATALOG_BUCKET=mise-catalog
# The public custom domain of the bucket (R2 > the bucket > Settings > Custom Domains),
# without a trailing slash.
R2_PUBLIC_URL=https://cdn.mise.art
