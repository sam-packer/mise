# Set credentials for catalog downloads and bundle uploads.
# Copy this file to ml/.env and enter your credentials. Git ignores ml/.env.
# The ML commands read ml/.env at startup. Values in the shell take priority.

# TMDB: themoviedb.org > Settings > API > request a key (Developer).
# Set either the "API Read Access Token" or the "API Key".
TMDB_TOKEN=
TMDB_API_KEY=

# Hardcover: sign in at hardcover.app, then copy the token from hardcover.app/account/api.
# Paste it without the "Bearer " prefix. It expires after one year.
HARDCOVER_TOKEN=

# ListenBrainz: sign in at listenbrainz.org, then copy the user token from
# listenbrainz.org/settings. The top recordings of each artist need it.
LISTENBRAINZ_TOKEN=

# Last.fm: create an API account at last.fm/api/account/create and copy the API key.
LASTFM_API_KEY=

# Smithsonian Open Access (optional): get a key at https://api.data.gov/signup/.
# Without a key, the other museums fill these art slots.
SMITHSONIAN_API_KEY=

# Hugging Face (optional): copy a read token from huggingface.co/settings/tokens.
# The models are public and do not require a token.
HF_TOKEN=

# Cloudflare R2, for `uv run publish`.
# Find the account ID in the bucket's S3 endpoint:
# https://<account id>.r2.cloudflarestorage.com (dashboard > R2 > the bucket > Settings).
R2_ACCOUNT_ID=
# Open Dashboard > R2 > Manage API tokens > Create API token.
# Choose "Object Read & Write" and restrict the token to the public bucket.
# Copy the Access Key ID and the Secret Access Key. The dashboard shows the secret only once.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# The bucket name. The default is "mise".
R2_BUCKET=mise
# Copy the public domain from R2 > the bucket > Settings > Custom Domains.
# Omit the trailing slash.
R2_PUBLIC_URL=https://cdn.mise.art
