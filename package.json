{
	"name": "moodboard",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . \"!ml/**\" && eslint .",
		"format": "prettier --write . \"!ml/**\"",
		"gen": "wrangler types",
		"stub": "bun scripts/build-stub-bundle.ts",
		"query": "bun scripts/query-bundle.ts",
		"deploy": "vite build && wrangler deploy"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^24.19.2",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"onnxruntime-node": "^1.31.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"sharp": "^0.35.5",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"wrangler": "^4.162.0"
	},
	"dependencies": {
		"@cf-wasm/og": "^0.5.0",
		"@huggingface/tokenizers": "^0.2.0",
		"onnxruntime-web": "^1.31.1"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
