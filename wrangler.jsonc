// Configure the Cloudflare app worker, static assets, and saved feelings.
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "mise",
	"compatibility_date": "2026-09-27",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// Store each short link's code and feeling in the MOODS namespace.
	"kv_namespaces": [{ "binding": "MOODS", "id": "73941fa8ddb9434f8ceddc6edbf3bc78" }],
	"workers_dev": true,
	"preview_urls": true
}
